#!/bin/bash
# Deploy the app's image to Dokku, if it differs from what's deployed. The app
# and image are read from files that Ansible writes.
set -euo pipefail

app=$(jq -r .app_name /etc/web-app/vars.json)
image=$(cat /etc/web-app/image)

docker pull --quiet "$image" > /dev/null
digest=$(docker image inspect --format '{{index .RepoDigests 0}}' "$image")
deployed=$(dokku git:report "$app" --git-source-image)

if [ "$digest" != "$deployed" ]; then
    # Deploy by digest, so Dokku records exactly which build is running
    dokku git:from-image "$app" "$digest"
fi
